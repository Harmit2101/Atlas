# ===================================================
# ATLAS ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and populate with your credentials.
# Never commit .env.local or secret keys to source control.
# ===================================================

# Untera Real Estate API (Free Tier: 1,000 req/day, 15 burst/min)
# Server-side only: used by Atlas server proxy (/api/untera/*)
# Generate a free key at https://untera.io
UNTERA_API_KEY=your_untera_api_key_here

# Supabase Free Tier Configuration
# Get your project URL and anon public key from https://supabase.com
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Razorpay Payment Gateway (India & Global)
# Client-side key for checkout modal:
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
# Server-side keys for order creation & signature verification:
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
