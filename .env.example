# ===================================================
# ATLAS ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and populate with your credentials.
# Never commit .env.local or secret keys to source control.
# ===================================================

# Untera Real Estate API (Free Tier: 1,000 req/day, 15 burst/min)
# Generate a free key at https://untera.io
VITE_UNTERA_API_KEY=your_untera_api_key_here

# Supabase Free Tier Configuration
# Get your project URL and anon public key from https://supabase.com
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
